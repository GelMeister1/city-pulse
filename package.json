{
  "name": "city-pulse",
  "productName": "City Pulse",
  "version": "0.6.19",
  "description": "Music-reactive city skyline visualizer: desktop widget and full-screen TV mode",
  "author": "GelMeister1",
  "license": "MIT",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never",
    "release": "electron-builder --win --publish always",
    "test": "node --test test/isours.test.js && electron test/layout.js && electron test/control.js",
    "dist:mac": "electron-builder --mac --publish never"
  },
  "build": {
    "appId": "com.gelmeister1.citypulse",
    "productName": "City Pulse",
    "files": [
      "index.html",
      "themes-a.js",
      "themes-b.js",
      "themes-c.js",
      "cities-world.js",
      "main.js",
      "isours.js",
      "preload.js",
      "winhelper.js",
      "audiocap.js",
      "assets/icon.png",
      "package.json"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "GelMeister1",
        "repo": "city-pulse",
        "releaseType": "release"
      }
    ],
    "win": {
      "icon": "assets/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": true,
      "include": "build/installer.nsh",
      "artifactName": "City-Pulse-Setup-${version}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "category": "public.app-category.entertainment",
      "identity": "-",
      "hardenedRuntime": false,
      "extendInfo": {
        "LSUIElement": true,
        "NSMicrophoneUsageDescription": "City Pulse listens to the input you choose (a microphone, line-in or BlackHole) so the city can light up to your music."
      }
    },
    "dmg": {
      "artifactName": "City-Pulse-${version}-${arch}.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "overrides": {
    "minimatch@>=7 <11.0.1": "^11.0.1"
  }
}
