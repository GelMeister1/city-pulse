{
  "name": "city-pulse",
  "productName": "City Pulse",
  "version": "0.4.2",
  "description": "Music-reactive city skyline visualizer: desktop widget and full-screen TV mode",
  "author": "GelMeister1",
  "license": "MIT",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never",
    "release": "electron-builder --win --publish always",
    "test": "node --test test/isours.test.js && electron test/layout.js"
  },
  "build": {
    "appId": "com.gelmeister1.citypulse",
    "productName": "City Pulse",
    "files": [
      "index.html",
      "themes-a.js",
      "themes-b.js",
      "cities-world.js",
      "main.js",
      "isours.js",
      "preload.js",
      "winhelper.js",
      "audiocap.js",
      "assets/icon.png",
      "package.json"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "GelMeister1",
        "repo": "city-pulse",
        "releaseType": "release"
      }
    ],
    "win": {
      "icon": "assets/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": true,
      "include": "build/installer.nsh",
      "artifactName": "City-Pulse-Setup-${version}.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
